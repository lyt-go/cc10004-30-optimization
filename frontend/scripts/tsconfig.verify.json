{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "outDir": "../.verify-build",
    "rootDir": "..",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["./**/*.ts", "../src/features/sentiment-link/**/*.ts"],
  "exclude": [
    "../src/features/sentiment-link/index.ts",
    "../src/features/sentiment-link/SentimentLinkView.tsx",
    "../src/features/sentiment-link/useSentiment-link.ts"
  ]
}
